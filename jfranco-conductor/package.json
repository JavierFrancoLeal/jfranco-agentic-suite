{
  "name": "@javierfrancoleal/conductor",
  "version": "1.0.25",
  "description": "The teacher organ of the J.Franco agentic workflow: detects friction between the user and the AI (repeated revisions, vague directives, frustration) and delivers micro-lessons from the conductor's guide, with prompt templates. Created by J.Franco.",
  "author": "J.Franco",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierFrancoLeal/jfranco-agentic-suite.git",
    "directory": "jfranco-conductor"
  },
  "homepage": "https://github.com/JavierFrancoLeal/jfranco-agentic-suite",
  "keywords": [
    "deepseek-harness",
    "agentic-workflow",
    "super-agent",
    "education",
    "vibe-coding",
    "friction"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.5"
  }
}
