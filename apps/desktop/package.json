{
  "name": "le-veilleux-desktop",
  "version": "0.1.0",
  "description": "Fanal Desktop — the universal sector dashboard as a desktop application (kiosk-ready). Created by J.Franco.",
  "author": "J.Franco",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "kiosk": "electron . --kiosk",
    "dist": "electron-builder --mac --win --linux"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ca.trasunto.fanal",
    "productName": "Fanal",
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "brain/**",
      "ui/**",
      "brain/agent-standby.sh"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png",
      "artifactName": "Fanal-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png",
      "artifactName": "Fanal-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Office"
    },
    "extraResources": [
      {
        "from": "../../dist/trasunto-runtime",
        "to": "runtime"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Fanal"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
