{
  "name": "le-veilleux-desktop",
  "version": "0.1.0",
  "description": "Le Veilleux Desktop — the universal sector dashboard as a desktop application (kiosk-ready). Created by J.Franco.",
  "author": "J.Franco",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "kiosk": "electron . --kiosk",
    "dist": "electron-builder --mac --win --linux"
  },
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "ca.jfranco.leveilleux",
    "productName": "Le Veilleux",
    "files": [
      "main.js",
      "preload.js",
      "assets/**",
      "brain/**",
      "ui/**",
      "welcome.html"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/icon.png"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png",
      "category": "Office"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true
  }
}
