{
  "name": "@javierfrancoleal/plugin-authoring",
  "version": "1.0.64",
  "description": "Plugin-authoring skill for DeepSeek Harness: the distilled anatomy, client-UI recipe, slots, locale, theme tokens, install steps, gotchas, and validation checklist for building and publishing new DSH plugins.",
  "author": "J.Franco",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.0"
  },
  "keywords": [
    "deepseek-harness",
    "plugin-authoring",
    "scaffold",
    "skill"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.5"
  }
}
