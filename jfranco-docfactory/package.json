{
  "name": "@javierfrancoleal/docfactory",
  "version": "1.0.129",
  "description": "The professional document factory of the J.Franco agentic workflow: consulting-grade techniques (boxes that never split pages, repeating table headers, no orphan lines, page numbers, metadata) + the editorial DNA (no meta-pointers, narrative flow, modest numbers, no over-promising) + a reusable docfx.py library. Created by J.Franco.",
  "author": "J.Franco",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierFrancoLeal/jfranco-agentic-suite.git",
    "directory": "jfranco-docfactory"
  },
  "homepage": "https://github.com/JavierFrancoLeal/jfranco-agentic-suite",
  "keywords": [
    "deepseek-harness",
    "agentic-workflow",
    "super-agent",
    "documents",
    "docx",
    "consulting"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "nodejsRange": ">=20",
      "dshRange": ">=0.2.1-rc.0",
      "dshReleases": {
        "0.2.2-alpha.2": "unknown",
        "0.2.2-alpha.3": "unknown",
        "0.2.2-rc.1": "unknown"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.5"
  }
}
