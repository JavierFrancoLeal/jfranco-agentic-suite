{
  "name": "@javierfrancoleal/accountability-auditor",
  "version": "1.1.124",
  "description": "Agentic-workflow stage 3: mandatory reflection and verification pass that emits an Accountability Report before every final output.",
  "author": "J.Franco",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "icon": "./icon.svg",
  "files": [
    "icon.svg",
    "locale/*.json",
    "lib/index.js",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "nodejsRange": ">=20",
      "dshRange": ">=0.2.1-rc.0",
      "dshReleases": {
        "0.2.2-alpha.2": "unknown",
        "0.2.2-alpha.3": "unknown",
        "0.2.2-rc.1": "unknown"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-skill": ">=0.2.1-rc.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavierFrancoLeal/jfranco-agentic-suite.git",
    "directory": "jfranco-accountability-auditor"
  },
  "homepage": "https://github.com/JavierFrancoLeal/jfranco-agentic-suite",
  "keywords": [
    "deepseek-harness",
    "agentic-workflow",
    "super-agent",
    "ai-assistant",
    "accountability",
    "plugins"
  ],
  "publishConfig": {
    "access": "public"
  }
}
